{
  "name": "command-desk",
  "productName": "Command Desk",
  "version": "0.4.0",
  "private": true,
  "description": "Editable Twitch chat command workflows for streamers",
  "author": "FermionaPlay",
  "license": "GPL-2.0-or-later",
  "main": "main.cjs",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tools/test-ui.cjs",
    "assets": "node tools/create-assets.cjs",
    "build": "node tools/build.cjs",
    "installer": "node tools/build-installer.cjs",
    "portable": "powershell -NoProfile -File tools/package-portable.ps1"
  },
  "dependencies": {
    "@twurple/api": "8.2.0",
    "@twurple/auth": "8.2.0",
    "@twurple/eventsub-ws": "8.2.0",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "42.11.18",
    "playwright": "1.58.2"
  }
}
